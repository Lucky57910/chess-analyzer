# SQLite for local dev, PostgreSQL in prod (Render gives you the URL)
DATABASE_URL=sqlite:///./chess.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# openssl rand -hex 32
SECRET_KEY=change-me-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Leave empty to allow open signup. Set it to lock registration behind a shared code.
REGISTRATION_CODE=

# Path to the stockfish binary. Docker image installs it at /usr/games/stockfish.
# On Windows: C:/Tools/stockfish/stockfish-windows-x86-64-avx2.exe
STOCKFISH_PATH=/usr/games/stockfish
# Windows local dev: ./engine/stockfish-windows-x86-64-avx2.exe
ENGINE_DEPTH=14
ENGINE_MAX_TIME=1.5
ENGINE_THREADS=1
ENGINE_HASH_MB=64
MAX_PLIES=200

# Poller
POLL_INTERVAL_SECONDS=15
ANALYSIS_INTERVAL_SECONDS=5
SYNC_MONTHS_ON_LOGIN=3

CHESS_COM_USER_AGENT=chess-analyzer/1.0 (contact: saloumaxime57@gmail.com)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
