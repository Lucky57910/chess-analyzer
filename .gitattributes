# `gradlew` is a shell script with no extension. CI runs it on Linux; checked
# out with CRLF it dies as "bad interpreter", which is a confusing way to lose
# an evening.
frontend/android/gradlew text eol=lf
frontend/android/gradle/wrapper/*.properties text eol=lf

# Never let end-of-line normalisation near a jar.
*.jar binary
