# Copy to .env next to docker-compose.yml and fill in. Never commit the result.

# The hostname Caddy will request a certificate for. Must already resolve to
# this instance's public IP, or the certificate request fails.
API_DOMAIN=chess-analyzer-api.duckdns.org

# Where the browser loads the frontend from. Exact match, comma-separated,
# no trailing slash.
CORS_ORIGINS=https://chess-analyzer-maxime-3ca0.vercel.app

POSTGRES_USER=chess
POSTGRES_PASSWORD=            # openssl rand -base64 32
POSTGRES_DB=chess_analyzer

SECRET_KEY=                   # openssl rand -hex 32 - changing it logs everyone out
REGISTRATION_CODE=

# Engine. Defaults live in docker-compose.yml; override here only to tune.
ENGINE_THREADS=1
ENGINE_HASH_MB=2048
ENGINE_DEPTH=18

# One-shot: re-derives stored accuracies at boot, on a background thread.
RECOMPUTE_ACCURACY_ON_BOOT=false
